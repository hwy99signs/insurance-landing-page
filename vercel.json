          "type": "host",
          "value": "homeownerclaimsguide.com"
        }
      ],
      "destination": "https://www.theinsuranceclaimsguide.com/books/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.homeownerclaimsguide.com"
        }
      ],
      "destination": "https://www.theinsuranceclaimsguide.com/books/",
      "permanent": true
    }
  ]
}
